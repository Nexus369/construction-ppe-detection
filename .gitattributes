# Binary files must never get line-ending conversion. Without this, git on
# Windows rewrites LF to CRLF inside them on checkout, which silently
# corrupts the file — a PDF that opens here would fail to open after a
# fresh clone.
*.pdf filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.woff filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text
*.db filter=lfs diff=lfs merge=lfs -text
# Source stays LF in the repo and is checked out however the platform wants.
*.py    text eol=lf
*.js    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.ino   text eol=lf
*.h     text eol=lf
# Shell scripts and desktop entries run on the Pi. A CRLF checkout
# makes the kernel look for an interpreter whose name ends in a stray
# carriage return, and fails with a message naming neither the file
# nor the reason.
*.sh      text eol=lf
*.desktop text eol=lf
*.service text eol=lf
*.onnx filter=lfs diff=lfs merge=lfs -text
